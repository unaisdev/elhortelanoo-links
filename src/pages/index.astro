---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import LinkButton from '../components/LinkButton.astro';
import { getEnv } from '../lib/auth';
import { getProfile, getVisibleLinks } from '../lib/db';

const env = getEnv();
const profile = await getProfile(env.DB);
const links = await getVisibleLinks(env.DB);
---

<Layout title={`${profile.display_name} | links`} description={profile.bio || undefined}>
  <main class="page-shell">
    <ProfileHeader
      displayName={profile.display_name}
      bio={profile.bio}
      avatarUrl={profile.avatar_url}
    />

    <section class="links" aria-label="Enlaces">
      {
        links.length === 0 ? (
          <p class="empty">Pronto habrá enlaces aquí.</p>
        ) : (
          links.map((link, index) => (
            <LinkButton
              title={link.title}
              url={link.url}
              iconUrl={link.icon_url}
              index={index}
            />
          ))
        )
      }
    </section>

    <footer class="footer">
      <span>elhortelanoo</span>
    </footer>
  </main>
</Layout>

<style>
  .links {
    display: grid;
    gap: 0.85rem;
  }

  .empty {
    text-align: center;
    color: var(--text-muted);
  }

  .footer {
    margin-top: 2.5rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    animation: fade 1s ease both 0.6s;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
