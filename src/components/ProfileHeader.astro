---
interface Props {
  displayName: string;
  bio: string;
  avatarUrl: string;
}

const { displayName, bio, avatarUrl } = Astro.props;
const initial = displayName.trim().charAt(0).toUpperCase() || 'E';
---

<header class="profile">
  <div class="avatar" aria-hidden={avatarUrl ? undefined : 'true'}>
    {
      avatarUrl ? (
        <img src={avatarUrl} alt="" width="112" height="112" loading="eager" />
      ) : (
        <span>{initial}</span>
      )
    }
  </div>
  <h1 class="brand">{displayName}</h1>
  {bio && <p class="bio">{bio}</p>}
</header>

<style>
  .profile {
    text-align: center;
    margin-bottom: 1.75rem;
    animation: rise 0.7s ease both;
  }

  .avatar {
    width: 7rem;
    height: 7rem;
    margin: 0 auto 1.1rem;
    border-radius: 999px;
    overflow: hidden;
    background: var(--accent-soft);
    border: 3px solid rgba(255, 255, 255, 0.18);
    box-shadow: var(--shadow);
    display: grid;
    place-items: center;
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--accent);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand {
    margin: 0;
    font-size: clamp(1.8rem, 5vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .bio {
    margin: 0.7rem auto 0;
    max-width: 28rem;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
