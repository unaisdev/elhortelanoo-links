{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "name": "elhortelanoo-links",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elhortelanoo",
      "database_id": "7b93428d-351c-4b65-9868-4d5370055255",
      "migrations_dir": "migrations"
    }
  ]
}
